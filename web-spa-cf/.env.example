# 现有 PHP 站点根 URL（无尾部斜杠），本地开发时 Vite 会把 /legacy-api 代理到这里
VITE_API_ORIGIN=https://你的php域名.com

# dabao 壳展示用（生产构建 Pages 时建议填真实值）
VITE_SITE_NAME=站点名称
VITE_SITE_URL=/
# 搜索跳转完整前缀，必须最终以 keyword= 结尾；留空则 dev 用 /legacy-api/... ，生产用 VITE_API_ORIGIN + /index.php?search-&keyword=
# VITE_SEARCH_PREFIX=https://api.example.com/index.php?search-&keyword=

# 可选：覆盖默认的 /template/dabao/Images/logo.png 与 erweima.png
# VITE_LOGO_URL=
# VITE_MOBILE_QR_URL=
